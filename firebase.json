{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/t/:template",
        "destination": "/app/t/:template",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/download",
        "destination": "/download.html"
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html"
      },
      {
        "source": "/docs",
        "destination": "/docs.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(index.html|download|download.html|pricing|pricing.html|docs|docs.html|site.css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/screens/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/@(main.dart.js|main.dart.wasm|main.dart.mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(ttf|otf|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/app/canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "macos": {
        "default": {
          "projectId": "pinbench",
          "appId": "1:992928145821:ios:1e972c0b11e1d6b37b4f74",
          "uploadDebugSymbols": true,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "pinbench",
          "configurations": {
            "macos": "1:992928145821:ios:1e972c0b11e1d6b37b4f74",
            "web": "1:992928145821:web:53667384727ca0797b4f74"
          }
        }
      }
    }
  }
}
