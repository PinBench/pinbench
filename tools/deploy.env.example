# Where your compile service runs. Copy to tools/deploy.env (git-ignored) and
# fill in; tools/deploy_compile_service.sh reads it.
# `:=` keeps a value already set in the environment, so a one-off override on
# the command line still wins.

# Public HTTPS base URL of the compile service. The web app calls it from the
# browser, so it is public by nature.
: "${COMPILE_API_URL:=https://compile.example.com}"

# SSH access to the machine it runs on (deploy_compile_service.sh only).
: "${COMPILE_SSH_HOST:=203.0.113.10}"
: "${COMPILE_SSH_USER:=ubuntu}"
: "${COMPILE_SSH_KEY:=$HOME/.ssh/compile_vm}"

# The site the service accepts requests from (its ALLOWED_ORIGINS).
: "${COMPILE_ORIGIN:=https://pinbench.web.app}"
