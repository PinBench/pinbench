{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pinbench",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "pinbench (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "pinbench (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            // Web + local compile service. Start PinBench/compile-service first
            // (see its README; it listens on :8080).
            // Then run this config so the web preview can compile edited
            // sketches instead of only the bundled precompiled templates.
            "name": "pinbench (web + compile service)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define=COMPILE_API_URL=http://localhost:8080"
            ]
        }
    ]
}