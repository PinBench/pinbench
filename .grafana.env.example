# Grafana Cloud OTLP credentials for OpenTelemetry export (native builds only).
#
# Copy this file to `.grafana.env` (gitignored) and fill in real values, then run
# the app with `tools/run_otel.sh` (which injects them as --dart-defines).
#
# Where to find these: Grafana Cloud Portal → your stack → "OpenTelemetry"
# (or the "Set up app monitoring" onboarding). Generate an API / Cloud Access
# Policy token with metrics:write, traces:write, logs:write scopes.

# OTLP endpoint base — the exporter appends /v1/traces and /v1/metrics.
OTEL_GRAFANA_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp

# Numeric instance ID (used as the OTLP basic-auth username).
OTEL_GRAFANA_INSTANCE_ID=000000

# API token (the OTLP basic-auth password). Keep secret — never commit.
OTEL_GRAFANA_TOKEN=glc_xxxxxxxxxxxxxxxxxxxxxxxx
