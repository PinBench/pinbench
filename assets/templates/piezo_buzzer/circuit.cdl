// Circuit description (.cdl) — kept in sync with the canvas.
// Edit components and wires here or on the canvas; both update together.
Circuit {
    uno := ArduinoUno {
        position: (-208, -176);
    }
    buzzer := PiezoBuzzer {
        position: (-32, -368);
        flip: H;
    }
    Wire {
        from: uno.8;
        to: buzzer.plus;
        color: red;
    }
    Wire {
        from: buzzer.minus;
        to: uno.GND_1;
        color: black;
        bends: [(4, -204), (-60, -204)];
    }
}
