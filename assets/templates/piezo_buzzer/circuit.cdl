// Circuit description (.cdl) — kept in sync with the canvas.
// Edit components and wires here or on the canvas; both update together.
Circuit {
    uno := ArduinoUno {
        position: (-264, -168);
    }
    servo := ServoMotor {
        position: (128, -480);
    }
    Wire {
        from: servo.vcc;
        to: uno.5V;
        color: red;
        bends: [(212, 192), (-36, 192)];
    }
    Wire {
        from: servo.signal;
        to: uno.9;
        color: orange;
        bends: [(228, -176), (-36, -176)];
    }
    Wire {
        from: servo.gnd;
        to: uno.GND_2;
        color: black;
        bends: [(196, 176), (-20, 176)];
    }
}
