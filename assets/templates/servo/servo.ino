// Servo sweep — drives a hobby servo on pin 9 back and forth.
//
// The 50 Hz control pulses are generated by hand (digitalWrite +
// delayMicroseconds) instead of the Servo library, so the sketch has no
// dependencies: each 20 ms frame starts with a 0.5–2.4 ms HIGH pulse whose
// width sets the horn's angle.

const int servoPin = 9;

void setup() {
  pinMode(servoPin, OUTPUT);
  Serial.begin(9600);
  Serial.println("Servo sweep starting");
}

// One 20 ms servo frame with a HIGH pulse of the given width.
void pulse(int widthMicroseconds) {
  digitalWrite(servoPin, HIGH);
  delayMicroseconds(widthMicroseconds);
  digitalWrite(servoPin, LOW);
  delay(20);
}

void loop() {
  // 0° -> 180°
  for (int us = 500; us <= 2400; us += 40) {
    pulse(us);
  }
  Serial.println("swept to 180");

  // 180° -> 0°
  for (int us = 2400; us >= 500; us -= 40) {
    pulse(us);
  }
  Serial.println("swept back to 0");
}
