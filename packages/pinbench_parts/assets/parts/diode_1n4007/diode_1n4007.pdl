# 1N4007 rectifier diode.
#
# The workhorse for turning AC into DC and for blocking a reversed supply.
# PHYSICS only, with the 1N4007's model numbers.
#
# Drawn by the `diode_1n4007` painter: vector paths generated from the
# "Diode 1N4007" frame in the PinBench Parts Figma file by the Flutter Da Vinci
# plugin.

PART "Rectifier Diode (1N4007)"
ID diode_1n4007
CATEGORY basic
DESCRIPTION "1 A general-purpose rectifier diode, DO-41"

# Standing on its leads, anode up: the tips are four hole pitches apart on
# the lattice, the cathode band toward the bottom one.
SIZE 40px 72px
PAINTER diode_1n4007

PINS
  anode    20px  4px   passive "A"
  cathode  20px  68px  passive "K"

PHYSICS diode
  n1 = anode
  n2 = cathode
  # SPICE model parameters: saturation current and emission coefficient.
  is = 7.02767e-9
  n = 1.80803
