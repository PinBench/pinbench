# N-Channel MOSFET in a TO-92 package.
#
# No BEHAVIOR: switching and amplifying are the solver's job, from the
# transistor model PHYSICS names.
# A level-1 model near a 2N7000 (threshold 2.1 V); `vto` and `kp` under
# PHYSICS override it. The body is tied to the source.
#
# Drawn by the shared `transistor_nmos` painter: vector paths generated from
# the "Transistor NMOS" frame in the PinBench Parts Figma file by the
# Flutter Da Vinci plugin. Only the drawing is Dart.

PART "N-Channel MOSFET"
ALIAS "NMOS"
ALIAS "2N7000"
ID transistor_nmos
CATEGORY basic
DESCRIPTION "N-channel enhancement MOSFET, TO-92 — drain, gate, source"

# Flat face forward, legs D G S left to right, their tips one hole pitch
# apart on the lattice.
SIZE 40px 72px
PAINTER transistor_nmos

PINS
  drain     4px   68px  passive  "D"
  gate      20px  68px  passive  "G"
  source    36px  68px  passive  "S"

PHYSICS nmos
  d = drain
  g = gate
  s = source
