# CR2032 coin cell in a holder — a battery you can put on the canvas.
#
# A real cell sags under load; this is an ideal source with a series
# resistance, which is the honest cheap model: enough that shorting it does
# not produce infinite current, not so much that it pretends to model
# discharge.
#
# Drawn by the `cr2032` painter rather than an SVG: vector paths generated
# from the "Coin Cell CR2032" frame in the PinBench Parts Figma file by the
# Flutter Da Vinci plugin. Only the drawing is Dart.

PART "Coin Cell (CR2032)"
ID cr2032
CATEGORY basic
DESCRIPTION "3V lithium coin cell"

# The holder stands upright between its leads, whose tips are thirteen hole
# pitches apart on the lattice: red (+) at the top, black (-) at the bottom.
SIZE 136px 200px
PAINTER cr2032

PINS
  plus   68px  4px    power   "+"
  minus  68px  196px  ground  "-"

PROPERTIES
  voltage  number  3  unit:"V"  label:"Cell voltage"

BEHAVIOR
  # A dead cell should read 0 V rather than a negative one.
  physics.voltage = max(prop.voltage, 0)

PHYSICS voltageSource
  n1 = plus
  n2 = minus
