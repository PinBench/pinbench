# P-Channel MOSFET in a TO-92 package.
#
# No BEHAVIOR: switching and amplifying are the solver's job, from the
# transistor model PHYSICS names.
# A level-1 model near a BS250 (threshold -2.1 V); `vto` and `kp` under
# PHYSICS override it. The body is tied to the source.
#
# Drawn by the shared `transistor_pmos` painter: vector paths generated from
# the "Transistor PMOS" frame in the PinBench Parts Figma file by the
# Flutter Da Vinci plugin. Only the drawing is Dart.

PART "P-Channel MOSFET"
ALIAS "PMOS"
ALIAS "BS250"
ID transistor_pmos
CATEGORY basic
DESCRIPTION "P-channel enhancement MOSFET, TO-92 — source, gate, drain"

# Flat face forward, legs S G D left to right, their tips one hole pitch
# apart on the lattice.
SIZE 40px 72px
PAINTER transistor_pmos

PINS
  source    4px   68px  passive  "S"
  gate      20px  68px  passive  "G"
  drain     36px  68px  passive  "D"

PHYSICS pmos
  d = drain
  g = gate
  s = source
