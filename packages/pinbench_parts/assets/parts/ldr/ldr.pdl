# LDR (photoresistor) — the reference data-driven part.
#
# Everything about how it behaves is data: pins, properties, and three lines
# of BEHAVIOR. Only the drawing is Dart — the `ldr` painter, vector paths
# generated from the "LDR" frame in the PinBench Parts Figma file by the
# Flutter Da Vinci plugin — which is the pattern for a part whose look does
# not change while it runs.

PART "LDR"
# The name this part shipped under, so circuits saved with it still load.
ALIAS "Photoresistor"
ID ldr
CATEGORY sensors
DESCRIPTION "Light-dependent resistor — resistance falls as light rises"

# The disc standing on its two leads, which end on the lattice one hole pitch
# apart — the ceramic capacitor's bounds.
SIZE 56px 52px

PAINTER ldr

PINS
  # id  x      y      role     label
  a     20px   52px   passive  "A"
  b     36px   52px   passive  "B"

PROPERTIES
  darkResistance  number  1000000  unit:"Ω"  label:"Dark resistance"
  lightResistance number  1000     unit:"Ω"  label:"Resistance at full light"
  illumination    number  50       unit:"%"  label:"Light on the sensor"

STATE
  # A scratch value so the resistance rule reads in two steps rather than one
  # unreadable expression. Reset to 0 at the start of every run.
  level  decimal  0

BEHAVIOR
  # `illumination` is a user-set percentage standing in for a light source;
  # a future light-emitting part can drive this same state instead.
  state.level        = clamp(prop.illumination, 0, 100) / 100
  # Log-ish falloff between the two published resistances.
  physics.resistance = max(prop.darkResistance - state.level * (prop.darkResistance - prop.lightResistance), prop.lightResistance)

PHYSICS resistor
  n1 = a
  n2 = b
