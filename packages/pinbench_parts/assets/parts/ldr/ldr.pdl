# Photoresistor (LDR) — the reference data-driven part.
#
# Everything here is data: the body is the SVG beside this file, and the
# electrical behaviour is three lines of BEHAVIOR. No Dart.

PART "Photoresistor"
ID ldr
CATEGORY sensors
DESCRIPTION "Light-dependent resistor — resistance falls as light rises"

# 12.7mm x 6.35mm, which is 5 x 2.5 hole pitches, so the leads land on the
# lattice at both ends.
SIZE 12.7mm 6.35mm

SVG "ldr.svg"

PINS
  # id  x       y      role     label
  a     4px     20px   passive  "A"
  b     68px    20px   passive  "B"

PROPERTIES
  darkResistance  number  1000000  unit:"Ω"  label:"Dark resistance"
  lightResistance number  1000     unit:"Ω"  label:"Resistance at full light"
  illumination    number  50       unit:"%"  label:"Light on the sensor"

STATE
  # A scratch value so the resistance rule reads in two steps rather than one
  # unreadable expression. Reset to 0 at the start of every run.
  level  decimal  0

BEHAVIOR
  # `illumination` is a user-set percentage standing in for a light source;
  # a future light-emitting part can drive this same state instead.
  state.level        = clamp(prop.illumination, 0, 100) / 100
  # Log-ish falloff between the two published resistances.
  physics.resistance = max(prop.darkResistance - state.level * (prop.darkResistance - prop.lightResistance), prop.lightResistance)

PHYSICS resistor
  n1 = a
  n2 = b
