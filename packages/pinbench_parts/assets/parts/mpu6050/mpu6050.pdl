# MPU-6050 accelerometer and gyroscope on the GY-521 module.
#
# An I²C part served by `LOGIC mpu6050`: WHO_AM_I, the power and range
# registers, and the 14-byte sample from 0x3B. Like the chip it boots asleep,
# so a sketch that never clears the sleep bit reads zeros, and it scales each
# reading to the range the sketch selected.
#
# The readings are properties: set the tilt and rotation you want the sketch to
# see. At rest and level, a sensor feels 1 g on Z.
#
# AD0 low or unconnected puts it at 0x68; tied to 5V or 3.3V, at 0x69. XDA,
# XCL and INT are there because the module has them; they are not modelled.

PART "Accelerometer + Gyro (MPU-6050)"
ID mpu6050
CATEGORY sensors
DESCRIPTION "I²C 6-axis motion sensor"

SIZE 20.32mm 15.24mm
SVG "mpu6050.svg"

LOGIC mpu6050

PINS
  vcc  4px    84px  power   "VCC"
  gnd  20px   84px  ground  "GND"
  scl  36px   84px  input   "SCL"
  sda  52px   84px  passive "SDA"
  xda  68px   84px  passive "XDA"
  xcl  84px   84px  passive "XCL"
  ad0  100px  84px  input   "AD0"
  int  116px  84px  output  "INT"

PROPERTIES
  accelX       number  0   unit:"g"    label:"Acceleration X"
  accelY       number  0   unit:"g"    label:"Acceleration Y"
  accelZ       number  1   unit:"g"    label:"Acceleration Z"
  gyroX        number  0   unit:"°/s"  label:"Rotation X"
  gyroY        number  0   unit:"°/s"  label:"Rotation Y"
  gyroZ        number  0   unit:"°/s"  label:"Rotation Z"
  temperature  number  25  unit:"°C"   label:"Die temperature"

STATE
  # Set once the power-on register values have been published this run.
  booted           boolean  false
  # PWR_MGMT_1, GYRO_CONFIG and ACCEL_CONFIG as the sketch last wrote them.
  # 0x40 is asleep, the chip's power-on value.
  powerManagement  integer  64
  gyroConfig       integer  0
  accelConfig      integer  0
