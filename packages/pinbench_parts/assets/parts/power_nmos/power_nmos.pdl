# N-Channel Power MOSFET in a TO-220 package.
#
# The same `nmos` element as the TO-92 one, with power-part numbers: a 2 V
# threshold and a transconductance near an IRLZ44N, tens of milliohms on at
# 5 V of gate drive.
#
# Drawn by the shared `to220_power_nmos` painter: vector paths generated from the
# "Power NMOS" frame in the PinBench Parts Figma file by the Flutter Da Vinci
# plugin. Only the drawing is Dart.

PART "N-Channel Power MOSFET"
ALIAS "IRLZ44N"
ID power_nmos
CATEGORY basic
DESCRIPTION "Logic-level N-channel power MOSFET, TO-220 — gate, drain, source"

# Tab up, legs G D S left to right, their tips one hole pitch apart on the
# lattice.
SIZE 72px 88px
PAINTER to220_power_nmos

PINS
  gate      20px  84px  passive  "G"
  drain     36px  84px  passive  "D"
  source    52px  84px  passive  "S"

PHYSICS nmos
  d = drain
  g = gate
  s = source
  vto = 2
  kp = 15
