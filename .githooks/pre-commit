#!/bin/sh

# Find staged files
staged_dart_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$')
staged_pubspec=$(git diff --cached --name-only --diff-filter=ACM | grep 'pubspec.yaml$')
staged_scratch_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^[^/]+\.(dart|py|ino)$')

# 0. Check for scratch files in the root directory
if [ -n "$staged_scratch_files" ]; then
    echo "⚠️ Temporary scratch files found in the root directory. Deleting them and continuing..."
    for file in $staged_scratch_files; do
        if [ -f "$file" ]; then
            git rm -f --cached "$file" > /dev/null 2>&1
            rm -f "$file"
            echo "   🗑️ Deleted: $file"
        fi
    done
fi

staged_templates=$(git diff --cached --name-only | grep '^assets/templates/')

# 1. Sync the template folders into pubspec.yaml's assets, when they changed.
#
# Only then: it is a list of folders, and nothing else can change it. It used
# to run on every commit, and `dart run` builds the dependency graph's native
# hooks first whenever they are stale — after any branch switch or dependency
# change — which made it ~45 s of a commit that touched no template.
if [ -n "$staged_templates" ]; then
    echo "📦 Syncing templates to pubspec.yaml..."
    dart run tools/update_templates.dart
fi

# 2. Sort pubspec if it was staged
if [ -n "$staged_pubspec" ] || [ -n "$staged_templates" ]; then
    echo "📦 Sorting pubspec.yaml dependencies..."
    dart run sort_pubspec_dependencies
    git add pubspec.yaml
fi

# 3. Sort imports in and format the staged Dart files
#
# No `dart fix --apply`. It analyzed the whole project to apply a handful of
# fixes — ~9 s, most of what was left of a commit — and rewrote files that were
# not staged. The lints it fixes show in the IDE and block at pre-push; run
# `dart fix --apply` yourself when they come up.
if [ -n "$staged_dart_files" ]; then
    echo "🧹 Sorting imports..."

    # Sort imports in the STAGED files only. `--folders lib` rewrote every file
    # under lib/ on every commit, and better_imports renders long `show` clauses
    # wrapped at 80 columns while this project formats at page_width:100 — so
    # each commit left unrelated, unstaged files dirty and oscillating.
    staged_csv=$(printf '%s,' $staged_dart_files | sed 's/,$//')
    dart pub global run better_imports --silent --relative --files "$staged_csv"

    # Format LAST. better_imports rewrites code, and its output is not
    # formatter-clean at page_width:100. Formatting before it
    # (or not at all) is how the tree drifted to 145 unformatted files and kept
    # CI's "Check formatting" step red for a month.
    echo "🎨 Formatting staged Dart files..."
    printf '%s\n' $staged_dart_files | xargs dart format >/dev/null

    # Re-stage only the dart files that were initially staged to include the fixes
    for file in $staged_dart_files; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
fi

# No analysis here. `dart analyze --fatal-infos` takes ~40-55 s on this
# project even for a single file — most of it loading the analyzer plugins —
# which is a commit you learn to skip with --no-verify. The IDE shows the same
# findings as you type, and pre-push analyzes the whole tree before anything
# reaches the remote, so a broken commit still cannot leave your machine.
#
# `dart analyze`, never `flutter analyze`, wherever it runs: `flutter analyze`
# does not load the analyzer plugins analysis_options.yaml registers, which is
# how 34 riverpod_lint findings once accumulated behind a clean hook.

echo "✅ All pre-commit checks passed!"
exit 0
